{
  "name": "@alimentation/web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-docs.mjs",
    "docs": "node scripts/build-docs.mjs",
    "preview": "vite preview",
    "test:e2e": "bun run --filter @alimentation/api build:server && bun run build && playwright test",
    "test:browsers": "bun run --filter @alimentation/api build:server && bun run build && playwright test -c playwright.browsers.config.ts",
    "test:idp": "playwright test -c playwright.idp.config.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@alimentation/core": "*",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@hookform/resolvers": "^7.0.9",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "beautiful-mermaid": "^1.1.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
