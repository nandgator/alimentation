{
  "name": "alimentation",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Mess and tiffin accounts for small kitchens, one private workspace each.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p apps/api && tsc -p apps/web && tsc -p apps/reference",
    "drift:db": "node scripts/drift-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:md": "prettier --write \"**/*.md\"",
    "format:ts": "biome format --write .",
    "format": "bun run format:md && bun run format:ts",
    "lint:md": "markdownlint-cli2 --fix",
    "lint:ts": "biome lint --write .",
    "lint": "bun run lint:md && bun run lint:ts",
    "check:md": "prettier --check \"**/*.md\" && markdownlint-cli2",
    "check:ts": "biome check --error-on-warnings .",
    "check": "bun run check:md && bun run check:ts && bun run typecheck && vitest run",
    "check:fix": "bun run format && bun run lint && bun run typecheck",
    "dev:api": "bun run --filter @alimentation/api dev",
    "dev:web": "bun run --filter @alimentation/web dev",
    "build:web": "bun run --filter @alimentation/web build",
    "build:reference": "bun run --filter @alimentation/reference build",
    "dev:reference": "bun run --filter @alimentation/reference dev",
    "test:e2e": "bun run --filter @alimentation/web test:e2e",
    "promises": "node scripts/check-promises.mjs",
    "design": "node scripts/check-design.mjs",
    "promises:write": "node scripts/check-promises.mjs --write",
    "smoke:compose": "scripts/smoke-compose.sh",
    "smoke:worker": "scripts/smoke-worker.sh",
    "smoke:live": "tsx scripts/smoke-live.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "overrides": {
    "workbox-build": {
      "glob": "^13.0.6"
    }
  }
}
