{
  "name": "alimentation",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Mess and tiffin accounts for small kitchens, one private workspace each.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p apps/api && tsc -p apps/web",
    "drift:db": "node scripts/drift-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "npm run dev -w @alimentation/api",
    "dev:web": "npm run dev -w @alimentation/web",
    "build:web": "npm run build -w @alimentation/web",
    "test:e2e": "npm run test:e2e -w @alimentation/web",
    "promises": "node scripts/check-promises.mjs",
    "design": "node scripts/check-design.mjs",
    "promises:write": "node scripts/check-promises.mjs --write",
    "smoke:compose": "scripts/smoke-compose.sh",
    "smoke:worker": "scripts/smoke-worker.sh",
    "smoke:live": "tsx scripts/smoke-live.mts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
